    {
      "name": "5. Exercices d'application",
      "description": "Les 3 exercices de la partie 12 du TP.",
      "item": [
        {
          "name": "Exercice 1 - Produits de la catégorie smartphones",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Code 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const smartphones = pm.response.json();",
                  "",
                  "pm.test(\"Au moins un produit est renvoyé\", function () {",
                  "    pm.expect(smartphones.products.length).to.be.above(0);",
                  "});",
                  "",
                  "pm.test(\"Tous les produits sont de la catégorie demandée\", function () {",
                  "    const cat = pm.environment.get(\"category\");",
                  "    smartphones.products.forEach(function (p) {",
                  "        pm.expect(p.category).to.eql(cat);",
                  "    });",
                  "});",
                  "",
                  "console.log(\"Nombre de smartphones : \" + smartphones.total);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/products/category/{{category}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "products",
                "category",
                "{{category}}"
              ]
            },
            "description": "Filtrage avec l'endpoint dédié /products/category/{nom}."
          },
          "response": []
        },
        {
          "name": "Exercice 2 - Ajouter un utilisateur",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Code 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const user = pm.response.json();",
                  "",
                  "pm.test(\"firstName, lastName et age sont bien renvoyés\", function () {",
                  "    pm.expect(user.firstName).to.eql(pm.environment.get(\"user_firstname\"));",
                  "    pm.expect(user.lastName).to.eql(pm.environment.get(\"user_lastname\"));",
                  "    pm.expect(user.age).to.eql(parseInt(pm.environment.get(\"user_age\")));",
                  "});",
                  "",
                  "pm.test(\"L'utilisateur a reçu un id\", function () {",
                  "    pm.expect(user).to.have.property(\"id\");",
                  "});",
                  "",
                  "pm.environment.set(\"new_user_id\", user.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
